# ─── Backend (API do Tutor IA) ───────────────────────────────────────────────
# URL do backend Express. Em produção, troque pela URL pública do seu backend.
VITE_API_URL=http://localhost:3001

# ─── Firebase (login + banco de dados) ────────────────────────────────────────
# Copie estes valores do Console do Firebase:
# Project settings (⚙️) → "Seus apps" → app Web → SDK setup and configuration.
# São chaves PÚBLICAS de cliente — podem ficar no frontend.
# Enquanto estiverem em branco, o app roda em "modo demo" (sem login).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=