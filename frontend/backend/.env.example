# Tutor IA: Google Gemini (tier gratuito)
# Pegue sua chave GRÁTIS em: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=sua_chave_aqui
# (opcional) modelo do Gemini. Default: gemini-2.5-flash
GEMINI_MODEL=gemini-2.5-flash

# URL do seu frontend (para CORS em produção)
# Exemplo: https://devlingo.vercel.app
FRONTEND_URL=http://localhost:5173

# Porta do servidor (o Render define automaticamente)
PORT=3001
